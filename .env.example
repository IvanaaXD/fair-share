# Copy to ".env" (same folder as docker-compose.yml) and fill in. ".env" must be in .gitignore.
POSTGRES_PASSWORD=promijeni_me
# At least 32 characters (HMAC-SHA256 key).
JWT_SECRET=promijeni_me_na_nasumican_niz_od_najmanje_32_znaka

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=tvoj_nalog@gmail.com
# Gmail "App password" (16 characters), not the account password.
EMAIL_PASSWORD=

# ---------- payment simulator ----------
PAYMENTS_DB_PASSWORD=promijeni_me_isto
# Two different random strings of at least 32 characters (the same generator as for JWT_SECRET).
# PAYMENT_API_KEY: the API's key for calling the simulator.
# PAYMENT_WEBHOOK_SECRET: the key of the HMAC signature on the simulator's webhooks.
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
